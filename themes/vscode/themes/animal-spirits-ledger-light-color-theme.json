    "editorCursor.foreground": "#C32B1F",
    "editorCursor.background": "#161110",
    "editor.selectionBackground": "#E6D2C6",
    "editor.lineHighlightBackground": "#E1DCD099",
    "editorLineNumber.foreground": "#5A524C",
    "editorLineNumber.activeForeground": "#161110",
    "editorBracketMatch.border": "#C32B1F",
    "editorBracketMatch.background": "#00000000",
    "editor.findMatchBackground": "#C32B1F8C",
    "editor.findMatchHighlightBackground": "#C32B1F38",
    "editorWhitespace.foreground": "#BDB5A6",
    "editorIndentGuide.background1": "#D5CFC2",
    "editorIndentGuide.activeBackground1": "#BDB5A6",
    "editorGutter.background": "#ECE8DE",
    "editorError.foreground": "#A8241A",
    "editorWarning.foreground": "#7A5A08",
    "editorInfo.foreground": "#1F5F78",
    "focusBorder": "#1F5F78",
    "foreground": "#161110",
    "descriptionForeground": "#5A524C",
    "textLink.foreground": "#1F5F78",
    "textLink.activeForeground": "#1F5F78",
    "errorForeground": "#A8241A",
    "sideBar.background": "#ECE8DE",
